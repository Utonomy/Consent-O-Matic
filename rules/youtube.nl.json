{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "rule_youtube_nl": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "ytd-consent-bump-v2-lightbox tp-yt-paper-dialog[role=\"dialog\"]"
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "tp-yt-paper-dialog[role=\"dialog\"].eom-v1-dialog",
            "displayFilter": true
          }
        }
      }
    ],
    "methods": [
      {
        "name": "UTILITY",
        "action": {
          "type": "click",
          "target": {
            "selector": "ytd-consent-bump-v2-lightbox .ytSpecButtonShapeNextFilled",
            "textFilter": [
              "Alles afwijzen",
              "Reject all",
              "Tout refuser",
              "Alle ablehnen"
            ]
          }
        }
      }
    ]
  }
}
