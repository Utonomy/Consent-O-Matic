{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"bever.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-testid=\"cookie-message-modal\"]"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-testid=\"cookie-message-modal\"]",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-testid=\"cookie-preferences-link\"]"
					}
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-testid=\"save-cookie-preferences-button\"]"
					}
				}
			}
		]
	}
}
