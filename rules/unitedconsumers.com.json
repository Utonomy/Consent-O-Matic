{
	"$schema": "../rules.schema.json",
	"unitedconsumers.com": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": "(^|[/.])unitedconsumers\\.com($|[/:])",
						"regexp": true
					},
					{
						"type": "css",
						"target": {
							"selector": "a[href$='/cookies#instellen']"
						}
					}
				],
				"showingMatcher": [
					{
						"type": "css",
						"target": {
							"selector": "a[href$='/cookies#instellen']",
							"displayFilter": true
						}
					}
				]
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"trueAction": {
								"type": "click",
								"target": {
									"selector": "div:has(> a[href$='/cookies#instellen']) > button",
									"textFilter": "Accepteren"
								}
							},
							"falseAction": {
								"type": "click",
								"target": {
									"selector": "div:has(> a[href$='/cookies#instellen']) > button",
									"textFilter": "Weigeren"
								}
							},
							"type": "F"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "UTILITY"
			}
		]
	}
}
