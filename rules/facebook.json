{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "Facebook": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["facebook.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "[aria-label=\"Decline optional cookies\"], [data-testid=\"cookie-policy-manage-dialog\"], [data-cookiebanner=\"accept_only_essential_button\"]"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[aria-label=\"Decline optional cookies\"], [data-testid=\"cookie-policy-manage-dialog\"], [data-cookiebanner=\"accept_only_essential_button\"]",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "[data-testid=\"cookie-policy-manage-dialog\"], [role=\"dialog\"]"
                    }
                },
                "name": "HIDE_CMP"
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "[aria-label=\"Allow all cookies\"], [data-cookiebanner=\"accept_button\"]"
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "[aria-label=\"Decline optional cookies\"], [data-cookiebanner=\"accept_only_essential_button\"]"
                        }
                    }
                },
                "name": "DO_CONSENT"
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
