{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "amazon": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["amazon.nl", "amazon.com", "amazon.de", "amazon.co.uk"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#glitter-form"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#glitter-form input[type=\"submit\"]",
                            "displayFilter": true
                        }
                    }
                ]
            },
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["amazon.nl", "amazon.com", "amazon.de", "amazon.co.uk"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#sp-cc-header, #sp-cc-accept, #sp-cc-customize"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#sp-cc-header, #sp-cc-accept, #sp-cc-customize",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#sp-cc-wrapper"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "ifcss",
                    "target": {
                        "selector": "#sp-cc-customize",
                        "displayFilter": true
                    },
                    "trueAction": {
                        "type": "ifallowall",
                        "falseAction": {
                            "type": "ifallownone",
                            "falseAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#sp-cc-customize"
                                }
                            }
                        }
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifcss",
                    "target": {
                        "selector": "#glitter-form",
                        "displayFilter": true
                    },
                    "trueAction": {
                        "type": "list",
                        "actions": [
                            {
                                "type": "waitcss",
                                "target": {
                                    "selector": "#glitter-form h1[id$=\"-title\"]",
                                    "displayFilter": true
                                },
                                "retries": 50,
                                "waitTime": 200
                            },
                            {
                                "type": "consent",
                                "consents": [
                                    {
                                        "type": "F",
                                        "matcher": {
                                            "type": "onoff",
                                            "onMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"on\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(4) .customize-container"
                                                    }
                                                }
                                            },
                                            "offMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"off\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(4) .customize-container"
                                                    }
                                                }
                                            }
                                        },
                                        "trueAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"on\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(4) .customize-container"
                                                }
                                            }
                                        },
                                        "falseAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"off\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(4) .customize-container"
                                                }
                                            }
                                        }
                                    },
                                    {
                                        "type": "F",
                                        "matcher": {
                                            "type": "onoff",
                                            "onMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"on\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(5) .customize-container"
                                                    }
                                                }
                                            },
                                            "offMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"off\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(5) .customize-container"
                                                    }
                                                }
                                            }
                                        },
                                        "trueAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"on\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(5) .customize-container"
                                                }
                                            }
                                        },
                                        "falseAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"off\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(5) .customize-container"
                                                }
                                            }
                                        }
                                    },
                                    {
                                        "type": "E",
                                        "matcher": {
                                            "type": "onoff",
                                            "onMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"on\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(6) .customize-container"
                                                    }
                                                }
                                            },
                                            "offMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"off\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(6) .customize-container"
                                                    }
                                                }
                                            }
                                        },
                                        "trueAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"on\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(6) .customize-container"
                                                }
                                            }
                                        },
                                        "falseAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"off\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(6) .customize-container"
                                                }
                                            }
                                        }
                                    },
                                    {
                                        "type": "F",
                                        "matcher": {
                                            "type": "onoff",
                                            "onMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"on\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(7) .customize-container"
                                                    }
                                                }
                                            },
                                            "offMatcher": {
                                                "target": {
                                                    "selector": "input[type=\"hidden\"][id$=\"-parent\"][value=\"off\"]",
                                                    "parent": {
                                                        "selector": "#glitter-form > div:nth-of-type(7) .customize-container"
                                                    }
                                                }
                                            }
                                        },
                                        "trueAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"on\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(7) .customize-container"
                                                }
                                            }
                                        },
                                        "falseAction": {
                                            "type": "click",
                                            "target": {
                                                "selector": "button[role=\"radio\"][value=\"off\"]",
                                                "parent": {
                                                    "selector": "#glitter-form > div:nth-of-type(7) .customize-container"
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    "falseAction": {
                        "type": "ifallowall",
                        "trueAction": {
                            "type": "click",
                            "target": {
                                "selector": "#sp-cc-accept, input[name='accept']"
                            }
                        },
                        "falseAction": {
                            "type": "ifallownone",
                            "trueAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#sp-cc-rejectall-link, input[name='decline']"
                                }
                            }
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "ifcss",
                    "target": {
                        "selector": "#glitter-form input[type=\"submit\"], #savePrefs .a-button-input",
                        "displayFilter": true
                    },
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "#glitter-form input[type=\"submit\"], #savePrefs .a-button-input"
                        }
                    }
                }
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
