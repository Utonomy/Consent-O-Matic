{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "amazon": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["amazon.nl", "amazon.com", "amazon.de", "amazon.co.uk"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#sp-cc, [data-testid='consent-manager-main-content'], #sp-cc-wrapper, form[action*='privacyprefs'], input[name='accept']"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#sp-cc, [data-testid='consent-manager-main-content'], #sp-cc-wrapper, form[action*='privacyprefs']",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP"
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "action": {
                    "type": "ifcss",
                    "target": {
                        "selector": "#sp-cc-customize"
                    },
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "#sp-cc-customize"
                        }
                    },
                    "falseAction": {
                        "type": "ifallowall",
                        "trueAction": {
                            "type": "click",
                            "target": {
                                "selector": "#sp-cc-accept, input[name='accept'], button",
                                "textFilter": ["Accept", "Accepteren", "Agree"]
                            }
                        },
                        "falseAction": {
                            "type": "click",
                            "target": {
                                "selector": "#sp-cc-rejectall-link, input[name='decline'], button",
                                "textFilter": ["Reject", "Decline", "Weigeren", "Essential"]
                            }
                        }
                    }
                },
                "name": "DO_CONSENT"
            },
            {
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#savePrefs .a-button-input, input[type='submit']"
                    }
                },
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
