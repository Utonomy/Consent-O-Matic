{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_brandnewday_nl": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": ["brandnewday.nl"]
					},
					{
						"type": "css",
						"target": {
							"selector": "#usercentrics-cmp-ui"
						}
					}
				],
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#save",
						"displayFilter": true
					},
					"parent": {
						"selector": "#usercentrics-cmp-ui"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "waitcss",
							"target": {
								"selector": "#save",
								"displayFilter": true
							},
							"parent": {
								"selector": "#usercentrics-cmp-ui"
							},
							"retries": 40,
							"waitTime": 250
						},
						{
							"type": "consent",
							"consents": [
								{
									"type": "B",
									"matcher": {
										"type": "onoff",
										"onMatcher": {
											"target": {
												"selector": "#uc-category-functional-toggle[aria-checked='true']"
											},
											"parent": {
												"selector": "#usercentrics-cmp-ui"
											}
										},
										"offMatcher": {
											"target": {
												"selector": "#uc-category-functional-toggle[aria-checked='false']"
											},
											"parent": {
												"selector": "#usercentrics-cmp-ui"
											}
										}
									},
									"toggleAction": {
										"type": "click",
										"target": {
											"selector": "#uc-category-functional-toggle"
										},
										"parent": {
											"selector": "#usercentrics-cmp-ui"
										}
									}
								},
								{
									"type": "F",
									"matcher": {
										"type": "onoff",
										"onMatcher": {
											"target": {
												"selector": "#uc-category-marketing-toggle[aria-checked='true']"
											},
											"parent": {
												"selector": "#usercentrics-cmp-ui"
											}
										},
										"offMatcher": {
											"target": {
												"selector": "#uc-category-marketing-toggle[aria-checked='false']"
											},
											"parent": {
												"selector": "#usercentrics-cmp-ui"
											}
										}
									},
									"toggleAction": {
										"type": "click",
										"target": {
											"selector": "#uc-category-marketing-toggle"
										},
										"parent": {
											"selector": "#usercentrics-cmp-ui"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#save"
					},
					"parent": {
						"selector": "#usercentrics-cmp-ui"
					}
				}
			}
		]
	}
}
