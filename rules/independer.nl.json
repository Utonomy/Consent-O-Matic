{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_independer_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookieBar"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookieBar .ind-cbar-right"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "click",
							"target": {
								"selector": "#cookieBar button[data-value=\"0\"]"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "#cookieBar"
							},
							"negated": true,
							"retries": 10,
							"waitTime": 100
						}
					]
				}
			}
		]
	}
}
