{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_otolift_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": ".cky-consent-container"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": ".cky-consent-container:not(.cky-hide)"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-cky-tag='reject-button']"
					}
				}
			}
		]
	}
}
