{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_wittebrug_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#CookieBanner"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#CookieBanner",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "waitcss",
							"target": {
								"selector": "#CustomCookiebotOpenDetails"
							},
							"retries": 10,
							"waitTime": 500
						},
						{
							"type": "click",
							"target": {
								"selector": "#CustomCookiebotOpenDetails"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "#CybotCookiebotDialogBodyLevelButtonPreferences"
							},
							"retries": 10,
							"waitTime": 500
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"type": "D",
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#CybotCookiebotDialogBodyLevelButtonPreferences"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#CybotCookiebotDialogBodyLevelButtonPreferences"
								}
							}
						},
						{
							"type": "B",
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#CybotCookiebotDialogBodyLevelButtonStatistics"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#CybotCookiebotDialogBodyLevelButtonStatistics"
								}
							}
						},
						{
							"type": "F",
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#CybotCookiebotDialogBodyLevelButtonMarketing"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#CybotCookiebotDialogBodyLevelButtonMarketing"
								}
							}
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection"
					}
				}
			}
		]
	}
}
