{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "youngcolfield.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#usercentrics-root"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "[data-testid='uc-default-banner']",
                        "displayFilter": true
                    },
                    "parent": {
                        "selector": "#usercentrics-root"
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "[data-testid='uc-deny-all-button']"
                    },
                    "parent": {
                        "selector": "#usercentrics-root"
                    }
                }
            }
        ]
    }
}
