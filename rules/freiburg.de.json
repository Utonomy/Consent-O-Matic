{
	"$schema": "../rules.schema.json",
	"freiburg.de": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": "(^|[/.])freiburg\\.de($|[/:])",
						"regexp": true
					},
					{
						"type": "css",
						"target": {
							"selector": "#ccm-widget .ccm--decline-cookies"
						}
					}
				],
				"showingMatcher": [
					{
						"type": "css",
						"target": {
							"selector": "#ccm-widget.ccm-show",
							"displayFilter": true
						}
					}
				]
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#ccm-widget button.ccm--decline-cookies"
					}
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "UTILITY"
			}
		]
	}
}
