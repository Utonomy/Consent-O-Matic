{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_belsimpel_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#js_privacy_banner"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#js_privacy_banner.js_open",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "click",
							"target": {
								"selector": ".js_privacy_banner_settings_btn"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": ".js_privacy_options_decline_all_btn"
							},
							"retries": 10,
							"waitTime": 200
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": ".js_privacy_options_decline_all_btn"
					}
				}
			}
		]
	}
}
