{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"ilost.co": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": "(^|[/.])ilost\\.co($|[/:])",
						"regexp": true
					},
					{
						"type": "css",
						"target": {
							"selector": "[role='dialog'][aria-labelledby='cookie-consent-title']"
						}
					}
				],
				"showingMatcher": [
					{
						"type": "css",
						"target": {
							"selector": "[role='dialog'][aria-labelledby='cookie-consent-title']",
							"displayFilter": true
						}
					}
				]
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "click",
							"target": {
								"selector": "[role='dialog'][aria-labelledby='cookie-consent-title'] div.border-t > button:first-child"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "[role='dialog'][aria-labelledby='cookie-consent-title'] button[role='switch'][aria-labelledby='cookie-consent-marketing-title']"
							},
							"retries": 10,
							"waitTime": 300
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"matcher": {
								"type": "css",
								"target": {
									"selector": "[role='dialog'][aria-labelledby='cookie-consent-title'] button[role='switch'][aria-labelledby='cookie-consent-marketing-title'][aria-checked='true']"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "[role='dialog'][aria-labelledby='cookie-consent-title'] button[role='switch'][aria-labelledby='cookie-consent-marketing-title']"
								}
							},
							"type": "F"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[role='dialog'][aria-labelledby='cookie-consent-title'] div.border-t > button"
					}
				}
			},
			{
				"name": "UTILITY"
			}
		]
	}
}
