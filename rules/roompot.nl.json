{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "roompot.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#CybotCookiebotDialog.cookiebot-popup"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#CybotCookiebotDialog.cookiebot-popup",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#CybotCookiebotDialog"
                            }
                        }
                    ]
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".js-change-cookie-preferences",
                        "displayFilter": true
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "#CybotCookiebotDialogBodyLevelButtonPreferences"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "#CybotCookiebotDialogBodyLevelButtonPreferences"
                                        }
                                    },
                                    "type": "F"
                                },
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "#CybotCookiebotDialogBodyLevelButtonStatistics"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "#CybotCookiebotDialogBodyLevelButtonStatistics"
                                        }
                                    },
                                    "type": "A"
                                },
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "#CybotCookiebotDialogBodyLevelButtonMarketing"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "#CybotCookiebotDialogBodyLevelButtonMarketing"
                                        }
                                    },
                                    "type": "F"
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection",
                        "displayFilter": true
                    }
                }
            }
        ]
    }
}
