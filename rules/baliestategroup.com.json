{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "baliestategroup.com": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "div[role='dialog'][aria-label='Cookievoorkeuren']"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "div[role='dialog'][aria-label='Cookievoorkeuren']"
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "button",
                        "textFilter": ["Alleen noodzakelijk"]
                    },
                    "parent": {
                        "selector": "div[role='dialog'][aria-label='Cookievoorkeuren']"
                    }
                }
            }
        ]
    }
}
