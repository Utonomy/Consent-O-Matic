{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "corendon_nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "iframe#consent_iframe"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "iframe#consent_iframe",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "waitcss",
                    "target": {
                        "selector": "iframe#consent_iframe"
                    },
                    "negated": true,
                    "retries": 30,
                    "waitTime": 500
                }
            }
        ]
    },
    "corendon_nl_iframe": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".stsp__cookie-container",
                        "iframeFilter": true
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".stsp__cookie-container",
                        "iframeFilter": true,
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "#acceptButton",
                            "iframeFilter": true
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "#declineButton",
                            "iframeFilter": true
                        }
                    }
                }
            }
        ]
    }
}
