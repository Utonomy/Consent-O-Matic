{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "eporner_cookies": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["eporner.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cookies"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cookies a, #cookies"
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#cookies"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#cookies a, #cookies button",
                        "textFilter": ["[ X ]", "X", "Close", "OK", "Accept"]
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
