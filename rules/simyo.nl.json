{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_simyo_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": ".cookie-bar__outer"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": ".cookie-bar__outer"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": ".cookie-bar .btn[data-id=\"0\"]"
					}
				}
			}
		]
	}
}
