{
    "$schema": "../rules.schema.json",
    "linkedin_popup": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["linkedin.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Accept", "Reject", "Accepteren", "Weigeren"]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Accept", "Reject", "Accepteren", "Weigeren"],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "div[type=\"COOKIE_CONSENT\"], .artdeco-global-alert, [role=\"alertdialog\"]"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Accept", "Accepteren", "Agree"]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Reject", "Weigeren", "Decline"]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
