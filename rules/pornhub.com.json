{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "pornhub": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["pornhub.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cookieBanner, .cbPrimaryCTA, .cbSecondaryCTA, button",
                            "textFilter": [
                                "Accept all cookies",
                                "Accept only essential cookies"
                            ]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cookieBanner, button",
                            "textFilter": [
                                "Accept all cookies",
                                "Accept only essential cookies"
                            ],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#cookieBanner, #cookieBannerWrapper"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".cbThirdCTA, button",
                        "textFilter": ["Customize Cookies"]
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": ".cbPrimaryCTA, button",
                            "textFilter": ["Accept all cookies"]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": ".cbSecondaryCTA, button",
                            "textFilter": ["Accept only essential cookies"]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
