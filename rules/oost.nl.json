{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "oost.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": { "selector": "#consent-plugin" }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": { "selector": "#consent-plugin-buttons" }
                }
            }
        ],
        "methods": [
            { "name": "HIDE_CMP", "action": { "type": "list", "actions": [] } },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": { "selector": "button[aria-label=\"Alles weigeren\"]" }
                }
            }
        ]
    }
}
