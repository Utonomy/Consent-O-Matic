{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "brightvibes.com": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#cookie-consent"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#cookie-consent",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#cookie-consent"
                            },
                            "forceHide": true
                        }
                    ]
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "type": "F",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "#cc-category-2"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "#cc-category-2"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": "#cc-form button[aria-label=\"Save cookie settings\"]",
                                "displayFilter": true
                            }
                        },
                        {
                            "type": "wait",
                            "waitTime": 500
                        },
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#cookie-consent"
                            },
                            "forceHide": true
                        }
                    ]
                }
            }
        ]
    }
}
