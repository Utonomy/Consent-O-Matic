{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "moetiknaardedokter.nl": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "#cookie-consent-decline-all-button"
          },
          "parent": {
            "selector": "cookie-consent-banner"
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": ".main",
            "displayFilter": true
          },
          "parent": {
            "selector": "cookie-consent-banner"
          }
        }
      }
    ],
    "methods": [
      {
        "name": "HIDE_CMP",
        "action": {
          "type": "list",
          "actions": []
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "#cookie-consent-decline-all-button"
          },
          "parent": {
            "selector": "cookie-consent-banner"
          }
        }
      }
    ]
  }
}
