{
	"$schema": "../rules.schema.json",
	"strato.nl": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": ["(^|[/.])strato\\.nl($|[/:])"],
						"regexp": true
					},
					{
						"type": "css",
						"target": {
							"selector": ".consent__wrapper #consentLayerOne"
						}
					}
				],
				"showingMatcher": [
					{
						"type": "css",
						"target": {
							"selector": ".consent__wrapper #consentLayerOne button#einstellungen",
							"displayFilter": true
						}
					}
				]
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "click",
							"target": {
								"selector": ".consent__wrapper #consentLayerOne button#einstellungen"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "#consentLayerTwo button#consentSubmit",
								"displayFilter": true
							},
							"retries": 10,
							"waitTime": 300
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#consentLayerTwo input#purpose2"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#consentLayerTwo label[for=\"purpose2\"]"
								}
							},
							"type": "B"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#consentLayerTwo input#purpose3"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#consentLayerTwo label[for=\"purpose3\"]"
								}
							},
							"type": "F"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#consentLayerTwo input#purpose4"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#consentLayerTwo label[for=\"purpose4\"]"
								}
							},
							"type": "F"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#consentLayerTwo button#consentSubmit"
					}
				}
			},
			{
				"name": "UTILITY"
			}
		]
	}
}
