{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"eikenvakman.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": ".wsa-cookielaw"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": ".wsa-cookielaw",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": ".cc-right a.btn.submit"
					}
				}
			}
		]
	}
}
