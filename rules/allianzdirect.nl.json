{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "allianzdirect_nl": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["allianzdirect.nl"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": ".optanon-alert-box-wrapper"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".optanon-alert-box-wrapper",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".optanon-toggle-display"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "wait",
                            "waitTime": 1000
                        },
                        {
                            "type": "foreach",
                            "target": {
                                "selector": "#optanon-popup-body-content"
                            },
                            "action": {
                                "type": "list",
                                "actions": [
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ":scope",
                                            "textFilter": ["Analytisch", "Statistiek", "Analytics", "Statistics", "Performance"]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": "input.optanon-status"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": "input.optanon-status"
                                                        }
                                                    },
                                                    "type": "B"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ":scope",
                                            "textFilter": ["Marketing", "Advertising", "Targeting"]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": "input.optanon-status"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": "input.optanon-status"
                                                        }
                                                    },
                                                    "type": "F"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "ifcss",
                                        "target": {
                                            "selector": ":scope",
                                            "textFilter": ["Functioneel", "Functional", "Comfort", "Voorkeuren", "Preferences"]
                                        },
                                        "trueAction": {
                                            "type": "consent",
                                            "consents": [
                                                {
                                                    "matcher": {
                                                        "type": "checkbox",
                                                        "target": {
                                                            "selector": "input.optanon-status"
                                                        }
                                                    },
                                                    "toggleAction": {
                                                        "type": "click",
                                                        "target": {
                                                            "selector": "input.optanon-status"
                                                        }
                                                    },
                                                    "type": "A"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "button"
                    },
                    "parent": {
                        "selector": ".optanon-save-settings-button"
                    }
                }
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
