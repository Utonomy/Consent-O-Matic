{
    "$schema": "../rules.schema.json",
    "allianzdirect_nl": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["(^|[/.])allianzdirect\\.nl($|[/:])"],
                        "regexp": true
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": ".optanon-alert-box-wrapper"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".optanon-alert-box-wrapper",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": {
                                "selector": ".optanon-alert-box-wrapper .optanon-toggle-display"
                            }
                        },
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "#optanon-popup-body-content[optanongroupid=\"2\"] input[type=\"checkbox\"]"
                            },
                            "retries": 10,
                            "waitTime": 300
                        }
                    ]
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#optanon-popup-body-content[optanongroupid=\"2\"] input[type=\"checkbox\"]"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#optanon-popup-body-content[optanongroupid=\"2\"] input[type=\"checkbox\"]"
                                }
                            },
                            "type": "B"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#optanon-popup-body-content[optanongroupid=\"4\"] input[type=\"checkbox\"]"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#optanon-popup-body-content[optanongroupid=\"4\"] input[type=\"checkbox\"]"
                                }
                            },
                            "type": "F"
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": {
                                "selector": "button"
                            },
                            "parent": {
                                "selector": ".optanon-save-settings-button"
                            }
                        },
                        {
                            "type": "wait",
                            "waitTime": 1000
                        }
                    ]
                }
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
