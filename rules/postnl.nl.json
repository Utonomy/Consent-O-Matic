{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "postnl_nl": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["postnl.nl"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": [
                                "Alles accepteren",
                                "Accept all",
                                "Akkoord",
                                "Alleen functioneel",
                                "Weigeren",
                                "Reject"
                            ]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": [
                                "Alles accepteren",
                                "Accept all",
                                "Akkoord",
                                "Alleen functioneel",
                                "Weigeren",
                                "Reject"
                            ],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#postnl-cookie-widget"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Alles accepteren", "Accept all", "Akkoord"]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": [
                                "Alleen functioneel",
                                "Weigeren",
                                "Reject",
                                "Decline",
                                "Essential"
                            ]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
