{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "voetbalzone_nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".sp_choice_type_11",
                        "iframeFilter": true
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".sp_choice_type_11",
                        "iframeFilter": true,
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".sp_choice_type_12"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": []
                }
            }
        ]
    },
    "voetbalzone_nl_privacy_manager": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".pm-switch, button.sp_choice_type_SAVE_AND_EXIT",
                        "iframeFilter": true
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "button.sp_choice_type_SAVE_AND_EXIT",
                        "iframeFilter": true,
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "multiclick",
                    "target": {
                        "selector": ".pm-switch[aria-checked='true'], [role='switch'][aria-checked='true']"
                    }
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "button.sp_choice_type_SAVE_AND_EXIT"
                    }
                }
            }
        ]
    }
}
