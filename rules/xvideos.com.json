{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "xvideos_disclaimer": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["xvideos.com", "xnxx.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#disclaimer-accept_cookies-btn, #disclaimer-reject_cookies-btn"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#disclaimer-accept_cookies-btn, #disclaimer-reject_cookies-btn",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#disclaimer, .disclaimer"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".disclaimer-manage_cookies, button",
                        "textFilter": ["Manage cookies"]
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "#disclaimer-accept_cookies-btn"
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "#disclaimer-reject_cookies-btn"
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
