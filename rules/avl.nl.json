{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "avl.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".OrangeCookie"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".OrangeCookie",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "type": "F",
                            "description": "Media (YouTube) cookies - optional, keep off",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#cookieChoice-Media"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#cookieChoice-Media"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#acceptselectedcookies"
                    }
                }
            }
        ]
    }
}
