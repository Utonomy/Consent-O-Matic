{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"foodello.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "url",
					"url": ["foodello.nl"]
				},
				"showingMatcher": {
					"type": "url",
					"url": ["foodello.nl"]
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "waitcss",
							"target": {
								"selector": "#onetrust-pc-btn-handler"
							},
							"retries": 40,
							"waitTime": 500
						},
						{
							"type": "click",
							"target": {
								"selector": "#onetrust-pc-btn-handler"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "#ot-group-id-C0002"
							},
							"retries": 10,
							"waitTime": 300
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#ot-group-id-C0002"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "label[for='ot-group-id-C0002']"
								}
							},
							"type": "B"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#ot-group-id-C0003"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "label[for='ot-group-id-C0003']"
								}
							},
							"type": "A"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#ot-group-id-C0004"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "label[for='ot-group-id-C0004']"
								}
							},
							"type": "F"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#ot-group-id-C0005"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "label[for='ot-group-id-C0005']"
								}
							},
							"type": "X"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": ".save-preference-btn-handler.onetrust-close-btn-handler"
					}
				}
			}
		]
	}
}
