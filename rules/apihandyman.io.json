{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"apihandyman.io": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": [
							"(^|[/.])apihandyman\\.io($|[/:])"
						],
						"regexp": true
					},
					{
						"type": "css",
						"target": {
							"selector": ".privacy-message a[onclick*='acceptPrivacyPolicy']"
						}
					}
				],
				"showingMatcher": [
					{
						"type": "css",
						"target": {
							"selector": ".privacy-message:not(.d-none)",
							"displayFilter": true
						}
					}
				]
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": ".privacy-message a[onclick*='acceptPrivacyPolicy']",
						"displayFilter": true
					}
				}
			}
		]
	}
}
