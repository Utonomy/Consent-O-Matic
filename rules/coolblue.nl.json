{
	"$schema": "../rules.schema.json",
	"coolblue.nl": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": "kaartje2go.nl",
						"negated": true
					},
					{
						"type": "css",
						"target": {
							"selector": "#cookie-banner-2025-form"
						}
					}
				],
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookie-banner-2025-form",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "button[name=\"accept_cookie\"][value=\"selection\"]"
					}
				}
			}
		]
	}
}
