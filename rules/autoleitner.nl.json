{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "autoleitner.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#cookiediv"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#cookiediv, .cookie-content",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#cookiediv"
                            },
                            "forceHide": true
                        },
                        {
                            "type": "hide",
                            "target": {
                                "selector": ".cookie-content"
                            },
                            "forceHide": true
                        }
                    ]
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".cookie-settings"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "type": "A",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "input.check_cls[value=\"Functionele cookies\"]"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "input.check_cls[value=\"Functionele cookies\"]"
                                }
                            }
                        },
                        {
                            "type": "B",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "input.check_cls[value=\"Analytische cookies\"]"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "input.check_cls[value=\"Analytische cookies\"]"
                                }
                            }
                        },
                        {
                            "type": "F",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "input.check_cls[value=\"Advertentie cookies\"]"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "input.check_cls[value=\"Advertentie cookies\"]"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#few_cookie_accept",
                        "displayFilter": true
                    }
                }
            }
        ]
    }
}
