{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "hu.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#cookiebanner, #CybotCookiebotDialogBodyLevelButtonAccept"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#cookiebanner",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#cookiebanner"
                            }
                        }
                    ]
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#CybotCookiebotDialogBodyLevelButtonAccept",
                        "displayFilter": true
                    }
                }
            }
        ]
    }
}
