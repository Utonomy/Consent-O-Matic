{
    "$schema": "../rules.schema.json",
    "booking_com": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": "euronext.com",
                        "negated": true
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#onetrust-consent-sdk #onetrust-banner-sdk"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#onetrust-consent-sdk #onetrust-banner-sdk",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#onetrust-pc-btn-handler"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "#ot-group-id-C0002"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "#ot-group-id-C0002"
                                        }
                                    },
                                    "type": "B"
                                }
                            ]
                        },
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "#ot-group-id-C0004"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "#ot-group-id-C0004"
                                        }
                                    },
                                    "type": "F"
                                }
                            ]
                        },
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "input.category-switch-handler"
                                        },
                                        "parent": {
                                            "selector": ".ot-cat-item",
                                            "textFilter": ["Marketing cookies", "Marketing Cookies"]
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "input.category-switch-handler"
                                        },
                                        "parent": {
                                            "selector": ".ot-cat-item",
                                            "textFilter": ["Marketing cookies", "Marketing Cookies"]
                                        }
                                    },
                                    "type": "F"
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "ifcss",
                    "target": {
                        "selector": ".save-preference-btn-handler"
                    },
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": ".save-preference-btn-handler"
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "#onetrust-banner-sdk #onetrust-reject-all-handler"
                        }
                    }
                }
            },
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#onetrust-consent-sdk"
                            }
                        }
                    ]
                }
            }
        ]
    }
}
