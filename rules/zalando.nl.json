{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "zalando_nl": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["zalando.nl", "zalando.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#usercentrics-root, .uc-banner-wrapper, .uc-banner-content, [data-testid=\"uc-banner\"]"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".uc-banner-wrapper, .uc-banner-content, [data-testid=\"uc-banner\"], #uc-btn-accept-banner, #uc-btn-deny-banner",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP"
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#uc-btn-more-info-banner, button",
                        "textFilter": ["Instellingen", "Settings", "More"]
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "#uc-btn-accept-banner, button",
                            "textFilter": ["Alles accepteren", "Accept all", "Akkoord", "Accept"]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "#uc-btn-deny-banner, button",
                            "textFilter": ["Weigeren", "Reject", "Decline", "Essential", "Deny"]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#uc-btn-save, button",
                        "textFilter": ["Opslaan", "Save", "Confirm"]
                    }
                }
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
