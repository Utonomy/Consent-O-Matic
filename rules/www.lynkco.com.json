{
	"$schema": "../rules.schema.json",
	"www.lynkco.com": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": ".modal-mask"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": ".modal-mask",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": ".modal-mask .buttonBox button",
						"textFilter": "Weiger alle onnodige cookies"
					}
				}
			}
		]
	}
}
