{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"ah.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-testid='cookie-popup']"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-testid='cookie-popup']",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "waitcss",
							"target": {
								"selector": "[data-testid='cookie-anchor-config']"
							},
							"retries": 10,
							"waitTime": 500
						},
						{
							"type": "click",
							"target": {
								"selector": "[data-testid='cookie-anchor-config']"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "#analyticsPA"
							},
							"retries": 10,
							"waitTime": 300
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#analyticsPA"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#analyticsPA"
								}
							},
							"type": "A"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#marketingAH"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#marketingAH"
								}
							},
							"type": "F"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#marketing3P"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#marketing3P"
								}
							},
							"type": "F"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "waitcss",
							"target": {
								"selector": "[data-testid='confirm-config']"
							},
							"retries": 10,
							"waitTime": 300
						},
						{
							"type": "click",
							"target": {
								"selector": "[data-testid='confirm-config']"
							}
						}
					]
				}
			}
		]
	}
}
