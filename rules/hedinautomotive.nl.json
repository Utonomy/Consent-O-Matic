{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "hedinautomotive_nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#CookieBanner"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#CookieBanner.is-visible-cookie-banner"
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#CustomCookiebotOpenDetails"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "type": "A",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonPreferences"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonPreferences"
                                }
                            }
                        },
                        {
                            "type": "B",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonStatistics"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonStatistics"
                                }
                            }
                        },
                        {
                            "type": "F",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonMarketing"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "#CybotCookiebotDialogBodyLevelButtonMarketing"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection"
                    }
                }
            }
        ]
    }
}
