{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"elektrio.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-termly-part=\"consent-banner\"]"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-termly-part=\"consent-banner\"]"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-tid=\"banner-decline\"]"
					}
				}
			}
		]
	}
}
