{
    "$schema": "../rules.schema.json",
    "headline.com": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": [
                            "(^|[/.])headline\\.com($|[/:])"
                        ],
                        "regexp": true
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "[class*='cookie-banner-module--root']"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[class*='cookie-banner-module--root']",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "[class*='cookie-banner-module--root'] [class*='cookie-banner-module--actions'] button:not([class*='cookie-banner-module--secondary'])"
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "[class*='cookie-banner-module--root'] button[class*='cookie-banner-module--secondary']"
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": []
                }
            }
        ]
    }
}
