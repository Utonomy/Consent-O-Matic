{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "properstar.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "div.consent div.consent-header span.consent-title"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "div.consent",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "div.consent-buttons button",
                        "textFilter": "Instellingen"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "input#consent-setting-performance"
                            },
                            "retries": 50,
                            "waitTime": 200
                        },
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "type": "B",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "input#consent-setting-performance"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "label[for=\"consent-setting-performance\"]"
                                        }
                                    }
                                },
                                {
                                    "type": "F",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": "input#consent-setting-advertising"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": "label[for=\"consent-setting-advertising\"]"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".consent-settings-modal-content .consent-buttons button",
                        "textFilter": "Mijn voorkeuren opslaan"
                    }
                }
            }
        ]
    }
}
