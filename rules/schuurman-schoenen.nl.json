{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_schuurman_schoenen_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": ".cookie-notification-modal"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": ".cookie-notification-modal.show-modal"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#analytical-cookies-consent"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#analytical-cookies-consent"
								}
							},
							"type": "A"
						},
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#marketing-cookies-consent"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#marketing-cookies-consent"
								}
							},
							"type": "B"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-cookie-button-type='useSelectCookies']"
					}
				}
			}
		]
	}
}
