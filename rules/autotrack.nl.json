{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"autotrack.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#as24-cmp-popup"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#as24-cmp-popup",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-testid=\"as24-cmp-partial-consent-button\"]"
					}
				}
			}
		]
	},
	"autotrack.nl_consent_management": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-testid=\"as24-cmp-accept-partial-button\"]"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-testid=\"as24-cmp-accept-partial-button\"]",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-testid=\"as24-cmp-accept-partial-button\"]"
					}
				}
			}
		]
	}
}
