{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_europarcs_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "div.consent-modal"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "div.consent-modal.consent-dialog-button--modal-open"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-consent--consent-management-target=\"declineButton\"]"
					}
				}
			}
		]
	}
}
