{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"nsinternational.com": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "dialog.cookie-overlay"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "dialog.cookie-overlay[open]"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "button.cookie-overlay__modal__footer__decline"
					}
				}
			}
		]
	}
}
