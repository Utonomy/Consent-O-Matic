{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "zelfhypotheekafsluiten.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": { "selector": "#diffuse-cookie-notice" }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#diffuse-cookie-notice .diffuseCookieAcceptAll",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": { "selector": "#diffuse-cookie-notice" }
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": { "selector": "#diffuse-cookie-notice .diffuseCookieSettings" }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "#dcn-option-2",
                                "displayFilter": true
                            },
                            "retries": 50,
                            "waitTime": 200
                        },
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "type": "D",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": { "selector": "#dcn-option-2" }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": { "selector": "#dcn-option-2" }
                                    }
                                },
                                {
                                    "type": "B",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": { "selector": "#dcn-option-3" }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": { "selector": "#dcn-option-3" }
                                    }
                                },
                                {
                                    "type": "F",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": { "selector": "#dcn-option-4" }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": { "selector": "#dcn-option-4" }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": { "selector": "#diffuse-cookie-notice .diffuseCookieAcceptSelection" }
                        },
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "#diffuse-cookie-notice .diffuseCookieAcceptAll, #diffuse-cookie-notice .diffuseCookieAcceptSelection"
                            },
                            "negated": true,
                            "retries": 20,
                            "waitTime": 200
                        }
                    ]
                }
            }
        ]
    }
}
