{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "marktplaats_nl": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["marktplaats.nl"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "[class^=\"sp_message_container\"], #sp-cc, button, [role=\"button\"]",
                            "textFilter": [
                                "Accepteren",
                                "Accept",
                                "Akkoord",
                                "Weigeren",
                                "Reject",
                                "Doorgaan zonder"
                            ]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[class^=\"sp_message_container\"], #sp-cc, button, [role=\"button\"]",
                            "textFilter": [
                                "Accepteren",
                                "Accept",
                                "Akkoord",
                                "Weigeren",
                                "Reject",
                                "Doorgaan zonder"
                            ],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "[class^=\"sp_message_container\"], #sp-cc"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Accepteren", "Accept", "Akkoord", "Agree"]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": [
                                "Weigeren",
                                "Reject",
                                "Decline",
                                "Essential",
                                "Doorgaan zonder"
                            ]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
