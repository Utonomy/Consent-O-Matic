{
    "$schema": "../rules.schema.json",
    "bright.nl": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": [
                            "(^|[/.])bright\\.nl($|[/:])"
                        ],
                        "regexp": true
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cmpbox"
                        },
                        "parent": {
                            "selector": "#cmpwrapper"
                        }
                    }
                ],
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "#cmpbox",
                        "displayFilter": true
                    },
                    "parent": {
                        "selector": "#cmpwrapper"
                    }
                }
            }
        ],
        "methods": []
    }
}
