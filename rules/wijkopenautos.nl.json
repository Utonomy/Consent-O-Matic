{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "wijkopenautos.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "[data-qa-selector=\"gdpr-banner-accept-all-button\"]"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "[data-qa-selector=\"gdpr-banner-accept-all-button\"]",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": {
                                "selector": "[data-qa-selector=\"gdpr-banner-configuration-button\"]"
                            }
                        },
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "[data-qa-selector=\"gdpr-banner-check-box-analytical\"]"
                            },
                            "retries": 10,
                            "waitTime": 300
                        }
                    ]
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "type": "B",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "[data-qa-selector=\"gdpr-banner-check-box-analytical\"]"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "[data-qa-selector=\"gdpr-banner-check-box-analytical\"]"
                                }
                            }
                        },
                        {
                            "type": "F",
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": "[data-qa-selector=\"gdpr-banner-check-box-marketing\"]"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": "[data-qa-selector=\"gdpr-banner-check-box-marketing\"]"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "[data-qa-selector=\"gdpr-banner-accept-selected-button\"]"
                    }
                }
            }
        ]
    }
}
