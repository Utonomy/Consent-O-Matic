{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "bol": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["bol.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "button",
                            "textFilter": ["Weigeren"]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "button",
                            "textFilter": ["Weigeren"],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "[role=\"dialog\"]"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "button",
                            "textFilter": ["Alles accepteren"]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "button",
                            "textFilter": ["Weigeren"]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
