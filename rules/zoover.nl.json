{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"zoover.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookieContent"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookieContent"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#cookieConsent"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#cookieConsent"
								}
							},
							"type": "B"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": ".tss-1y17x51-container-medium"
					}
				}
			}
		]
	}
}
