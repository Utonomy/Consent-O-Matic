{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "rule_oxxio_nl": {
    "detectors": [
      {
        "presentMatcher": {
          "type": "css",
          "target": {
            "selector": "div[role=\"alertdialog\"]",
            "childFilter": {
              "target": {
                "selector": "button.sparky-button",
                "textFilter": "Weigeren"
              }
            }
          }
        },
        "showingMatcher": {
          "type": "css",
          "target": {
            "selector": "div[role=\"alertdialog\"]",
            "displayFilter": true,
            "childFilter": {
              "target": {
                "selector": "button.sparky-button",
                "textFilter": "Weigeren"
              }
            }
          }
        }
      }
    ],
    "methods": [
      {
        "name": "HIDE_CMP",
        "action": {
          "type": "list",
          "actions": []
        }
      },
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "button.sparky-button",
            "textFilter": "Weigeren",
            "displayFilter": true
          }
        }
      }
    ]
  }
}
