{
	"$schema": "../rules.schema.json",
	"columbia.edu": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": ["(^|[/.])columbia\\.edu($|[/:])"],
						"regexp": true
					},
					{
						"type": "css",
						"target": {
							"selector": "#cu-privacy-notice"
						}
					}
				],
				"showingMatcher": [
					{
						"type": "css",
						"target": {
							"selector": "#cu-privacy-notice",
							"displayFilter": true
						}
					}
				]
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "hide",
					"target": {
						"selector": "#cu-privacy-notice"
					}
				}
			},
			{
				"name": "OPEN_OPTIONS"
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#cu-privacy-notice button"
					}
				}
			},
			{
				"name": "SAVE_CONSENT"
			},
			{
				"name": "UTILITY"
			}
		]
	}
}
