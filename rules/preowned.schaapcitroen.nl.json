{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "preowned.schaapcitroen.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".z-overlay"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".z-overlay",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "button",
                        "textFilter": ["Weiger"]
                    },
                    "parent": {
                        "selector": ".z-overlay"
                    }
                }
            }
        ]
    }
}
