{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "rabobank_nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "feature-modular-cookiebanner-variant-one"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "rds-button.cookiebanner-consent-level-button"
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "parent": {
                                "selector": "#modular-cookiebanner-variant-one-consent-level-button-1"
                            },
                            "target": {
                                "selector": ".rds-button"
                            }
                        },
                        {
                            "type": "wait",
                            "waitTime": 1500
                        }
                    ]
                }
            }
        ]
    }
}
