{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"klm.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": ".bw-cookie-banner"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": ".bw-cookie-banner",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "click",
					"target": {
						"selector": "#change_cookie_settings_btn-link"
					}
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#save_change_settings_btn"
					}
				}
			}
		]
	}
}
