{
	"$schema": "../rules.schema.json",
	"utonomy_cookie_consent_example": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookie-popup"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookie-popup.show"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#ok-button"
					}
				}
			}
		]
	}
}
