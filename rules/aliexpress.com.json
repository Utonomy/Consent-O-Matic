
{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "AliExpress": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#gdpr-new-container"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#gdpr-new-container",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#gdpr-new-container button",
                        "textFilter": [
                            "Cookies weigeren",
                            "Reject all",
                            "Decline all",
                            "Reject"
                        ]
                    }
                },
                "name": "DO_CONSENT"
            }
        ]
    }
}
