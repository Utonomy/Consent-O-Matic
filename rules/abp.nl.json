{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"abp.nl": {
		"detectors": [
			{
				"presentMatcher": [
					{
						"type": "url",
						"url": ["(^|[/.])abp\\.nl($|[/:])"],
						"regexp": true
					},
					{
						"type": "css",
						"target": {
							"selector": ".js-cookies-pop-up #onload-modal"
						}
					}
				],
				"showingMatcher": [
					{
						"type": "css",
						"target": {
							"selector": ".js-cookies-pop-up #onload-modal .js-settings button",
							"displayFilter": true
						}
					}
				]
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "click",
							"target": {
								"selector": ".js-cookies-pop-up #onload-modal .js-settings button"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "#settings-modal input#personalization-cookie",
								"displayFilter": true
							},
							"retries": 10,
							"waitTime": 300
						},
						{
							"type": "wait",
							"waitTime": 800
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "consent",
					"consents": [
						{
							"matcher": {
								"type": "checkbox",
								"target": {
									"selector": "#settings-modal input#personalization-cookie"
								}
							},
							"toggleAction": {
								"type": "click",
								"target": {
									"selector": "#settings-modal input#personalization-cookie"
								}
							},
							"type": "F"
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "wait",
							"waitTime": 500
						},
						{
							"type": "click",
							"target": {
								"selector": "#settings-modal .js-save-custom button"
							}
						},
						{
							"type": "wait",
							"waitTime": 1000
						}
					]
				}
			},
			{
				"name": "UTILITY"
			}
		]
	}
}
