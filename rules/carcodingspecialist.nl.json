{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "carcodingspecialist.nl": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".flowappz-cookie-consent-popup-13"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".flowappz-cookie-consent-popup-13:not(.flowappz-hide-popup)"
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "[flowappz-cookie-command=\"reject-all\"]"
                    }
                }
            }
        ]
    }
}
