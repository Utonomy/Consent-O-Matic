{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "xhamster": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["xhamster.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Accept", "Reject"]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Accept", "Reject"],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP"
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Accept"]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "button, [role=\"button\"]",
                            "textFilter": ["Reject"]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
