{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"luchen.geldrop-mierlo.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "div[class*=\"CookieBanner-module\"]"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "div[class*=\"CookieBanner-module\"]",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "button",
						"textFilter": ["Accepteer noodzakelijke cookies"]
					}
				}
			}
		]
	}
}
