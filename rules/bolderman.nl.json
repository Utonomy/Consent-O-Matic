{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_bolderman_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "via-modal.via-modal--consent"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "via-modal.via-modal--consent"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-dmp-event='SavePrivacyConsentRejectAll']"
					}
				}
			}
		]
	}
}
