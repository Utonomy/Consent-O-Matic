{
    "$schema": "../rules.schema.json",
    "shein.com": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": [
                            "(^|[/.])shein\\.com($|[/:])"
                        ],
                        "regexp": true
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": ".cmp_c_1100 .cmp_c_1102 .cmp_c_1"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": ".cmp_c_1100 .cmp_c_1102",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": {
                                "selector": ".cmp_c_1100 .cmp_c_1102 .cmp_c_1"
                            }
                        },
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": ".cmp_c_1200 .list input[type='checkbox']"
                            },
                            "retries": 20,
                            "waitTime": 250
                        }
                    ]
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "consent",
                    "consents": [
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(2) .item input[type='checkbox']"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(2) .item label"
                                }
                            },
                            "type": "B"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(3) .item input[type='checkbox']"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(3) .item label"
                                }
                            },
                            "type": "D"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(4) .item input[type='checkbox']"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(4) .item label"
                                }
                            },
                            "type": "F"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(5) .item input[type='checkbox']"
                                }
                            },
                            "toggleAction": {
                                "type": "click",
                                "target": {
                                    "selector": ".cmp_c_1200 .list > div:nth-child(5) .item label"
                                }
                            },
                            "type": "X"
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".cmp_c_1204 .cmp_c_5"
                    }
                }
            }
        ]
    }
}
