{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_nederlandseloterij_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-test=\"consent-reject-all\"]"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "[data-test=\"consent-reject-all\"]",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "[data-test=\"consent-reject-all\"]"
					}
				}
			}
		]
	}
}
