{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "cookedandloved.com": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": [
                            "(^|[/.])cookedandloved\\.com($|[/:])"
                        ],
                        "regexp": true
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cmpbox"
                        },
                        "parent": {
                            "selector": "#cmpwrapper"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#cmpbox",
                            "displayFilter": true
                        },
                        "parent": {
                            "selector": "#cmpwrapper"
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "a.cmpboxbtnyes"
                        },
                        "parent": {
                            "selector": "#cmpwrapper"
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "a.cmpboxbtnno"
                        },
                        "parent": {
                            "selector": "#cmpwrapper"
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "list",
                    "actions": []
                }
            }
        ]
    }
}
