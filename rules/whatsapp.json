{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "whatsapp": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["whatsapp.com", "web.whatsapp.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "[aria-label=\"Decline optional cookies\"], [data-testid=\"wa_cookies_banner_modal\"]"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "[aria-label=\"Decline optional cookies\"], [data-testid=\"wa_cookies_banner_modal\"]",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "[role=\"dialog\"], [data-testid=\"wa_cookies_banner_modal\"]"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "[aria-label=\"Allow all cookies\"], [data-cookiebanner=\"accept_button\"]"
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "[aria-label=\"Decline optional cookies\"], [data-cookiebanner=\"accept_only_essential_button\"]"
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
