{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"hallmark.nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#preferences-box"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#preferences-box",
						"displayFilter": true
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "OPEN_OPTIONS",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "click",
							"target": {
								"selector": "button[data-js=\"open-settings\"]"
							}
						},
						{
							"type": "waitcss",
							"target": {
								"selector": "#mandatory"
							},
							"retries": 10,
							"waitTime": 300
						}
					]
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "list",
					"actions": [
						{
							"type": "click",
							"target": {
								"selector": "#mandatory"
							}
						}
					]
				}
			},
			{
				"name": "SAVE_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "button[data-js=\"select-preferences\"]"
					}
				}
			}
		]
	}
}
