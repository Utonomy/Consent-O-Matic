{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "eu.waldorandco.com": {
        "detectors": [
            {
                "presentMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".pd-cookie-banner-window"
                    }
                },
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": ".pd-cookie-banner-window",
                        "displayFilter": true
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".cc-settings"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "#pd-cp-preferences",
                                "displayFilter": true
                            },
                            "retries": 50,
                            "waitTime": 200
                        },
                        {
                            "type": "click",
                            "target": {
                                "selector": ".pd-cp-ui-rejectAll"
                            }
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": ".pd-cp-ui-save"
                    }
                }
            }
        ]
    }
}
