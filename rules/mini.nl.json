{
    "$schema": "../rules.schema.json",
    "mini.nl": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": [
                            "(^|[/.])mini\\.nl($|[/:])"
                        ],
                        "regexp": true
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "section.consentDrawer"
                        },
                        "parent": {
                            "selector": "epaas-consent-drawer-shell"
                        }
                    }
                ],
                "showingMatcher": {
                    "type": "css",
                    "target": {
                        "selector": "section.consentDrawer",
                        "displayFilter": true
                    },
                    "parent": {
                        "selector": "epaas-consent-drawer-shell"
                    }
                }
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": []
                }
            },
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "click",
                            "target": {
                                "selector": ".buttonsDefault .personalize-button",
                                "displayFilter": true
                            },
                            "parent": {
                                "selector": "epaas-consent-drawer-shell"
                            }
                        },
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": "epaas-policy-page-shell"
                            },
                            "parent": {
                                "selector": "epaas-consent-drawer-shell"
                            },
                            "retries": 40,
                            "waitTime": 200
                        },
                        {
                            "type": "runrooted",
                            "parent": {
                                "selector": "epaas-consent-drawer-shell"
                            },
                            "target": {
                                "selector": "epaas-policy-page-shell"
                            },
                            "action": {
                                "type": "waitcss",
                                "target": {
                                    "selector": "input[aria-labelledby='advertisingToggleLabel']"
                                },
                                "retries": 40,
                                "waitTime": 200
                            }
                        }
                    ]
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "runrooted",
                    "parent": {
                        "selector": "epaas-consent-drawer-shell"
                    },
                    "target": {
                        "selector": "epaas-policy-page-shell"
                    },
                    "action": {
                        "type": "consent",
                        "consents": [
                            {
                                "type": "F",
                                "matcher": {
                                    "type": "onoff",
                                    "onMatcher": {
                                        "target": {
                                            "selector": "input[aria-labelledby='advertisingToggleLabel']:checked"
                                        }
                                    },
                                    "offMatcher": {
                                        "target": {
                                            "selector": "input[aria-labelledby='advertisingToggleLabel']:not(:checked)"
                                        }
                                    }
                                },
                                "toggleAction": {
                                    "type": "click",
                                    "target": {
                                        "selector": "input[aria-labelledby='advertisingToggleLabel']"
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "runrooted",
                    "parent": {
                        "selector": "epaas-consent-drawer-shell"
                    },
                    "target": {
                        "selector": "epaas-policy-page-shell"
                    },
                    "action": {
                        "type": "ifcss",
                        "target": {
                            "selector": "input[aria-labelledby='advertisingToggleLabel']:checked"
                        },
                        "trueAction": {
                            "type": "runrooted",
                            "ignoreOldRoot": true,
                            "target": {
                                "selector": "epaas-consent-drawer-shell"
                            },
                            "action": {
                                "type": "click",
                                "target": {
                                    "selector": ".save-button",
                                    "displayFilter": true
                                }
                            }
                        },
                        "falseAction": {
                            "type": "runrooted",
                            "ignoreOldRoot": true,
                            "target": {
                                "selector": "epaas-consent-drawer-shell"
                            },
                            "action": {
                                "type": "click",
                                "target": {
                                    "selector": ".reject-button",
                                    "displayFilter": true
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
