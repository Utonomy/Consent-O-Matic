{
	"$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
	"rule_toptaarten_nl": {
		"detectors": [
			{
				"presentMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookie-consent-cookie-bar-center"
					}
				},
				"showingMatcher": {
					"type": "css",
					"target": {
						"selector": "#cookie-consent-cookie-bar-center:not([style*='display: none']):not([style*='display:none'])"
					}
				}
			}
		],
		"methods": [
			{
				"name": "HIDE_CMP",
				"action": {
					"type": "list",
					"actions": []
				}
			},
			{
				"name": "DO_CONSENT",
				"action": {
					"type": "click",
					"target": {
						"selector": "#CookieConsentIOReject"
					}
				}
			}
		]
	}
}
