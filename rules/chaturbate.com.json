{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "chaturbate_entrance": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "url",
                        "url": ["chaturbate.com"]
                    },
                    {
                        "type": "css",
                        "target": {
                            "selector": "#close_entrance_terms, button",
                            "textFilter": ["I AGREE", "Agree"]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#close_entrance_terms, button",
                            "textFilter": ["I AGREE", "Agree"],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "#entrance_terms, .entrance_terms, [id*=\"entrance\"]"
                    }
                }
            },
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "click",
                    "target": {
                        "selector": "#close_entrance_terms, button",
                        "textFilter": ["I AGREE", "Agree"]
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
